# ---------------------------------------------------------------------------
# Jellyfin Wrapped configuration. Copy to:
#   .env                         for Docker Compose (production)
#   .env.development.local       for the local dev server (pnpm dev:start)
# Never commit the real files — they're gitignored.
# All service credentials live here only; the admin UI never edits them.
# ---------------------------------------------------------------------------

# --- Jellyfin (10.11 or 12.x) -------------------------------------------------
# Dashboard → API Keys → "+" to create a key. Used for user lookups, metadata and artwork.
JELLYFIN_URL=http://jellyfin.lan:8096
JELLYFIN_API_KEY=

# --- Jellystat (playback history) ---------------------------------------------
# Jellystat → Settings → API Keys.
JELLYSTAT_URL=http://jellystat.lan:3000
JELLYSTAT_API_KEY=

# --- Seerr / Jellyseerr / Overseerr (requests + TMDb metadata) -----------------
# Settings → General → API Key. Optional: without it the "You Requested It" slide,
# TMDb popularity and recovery of deleted titles are unavailable.
SEERR_URL=http://seerr.lan:5055
SEERR_API_KEY=

# --- Soundtracks ----------------------------------------------------------------
# Soundtrack track lists, popularity and 30-second previews come from Deezer's public API
# (no key; only movie/show titles are sent). Set to false to disable lookups.
# DEEZER_ENABLED=true

# yt-dlp for "grab audio from YouTube" (preinstalled in the Docker image).
# Defaults to `yt-dlp` on PATH.
# YTDLP_PATH=/usr/local/bin/yt-dlp

# --- Security -------------------------------------------------------------------
# 32+ random characters. Encrypts personal-link tokens and signs analytics tokens.
# Keep it stable: changing it invalidates existing personal links and sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a secret is generated and persisted in DATA_DIR/.app-secret.
APP_SECRET=

# Public URL users reach the app on. REQUIRED behind a reverse proxy (HTTPS), used for
# CSRF protection, secure cookies and the personal links shown in the admin panel.
# ORIGIN=https://wrapped.example.com

# Behind a reverse proxy: trust its client-IP header for rate limiting.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Session cookie "Secure" flag: auto (follow request protocol) | true | false
# COOKIE_SECURE=auto
# SESSION_TTL_HOURS=336

# --- Behaviour --------------------------------------------------------------------
# Timezone used for days, hours and year boundaries (IANA name). Defaults to TZ, then UTC.
WRAPPED_TIMEZONE=America/Chicago

# If Jellystat imported history from the Playback Reporting plugin and those timestamps
# were recorded in server-local time, set that zone so they are interpreted correctly.
# JELLYSTAT_IMPORTED_TZ=America/Chicago

# Mock-data preview at /preview (default: on in development, off in production).
# MOCK_PREVIEW=false

# --- Docker / dev only ------------------------------------------------------------------
# Host port for docker compose, image owner on GHCR, and the dev server port.
# WRAPPED_PORT=3000
# GHCR_OWNER=your-github-user
# DEV_PORT=5173
# DATA_DIR=./data
